# Server only. Do not put vendor credentials in the iOS app.
VENTURE_CALL_SERVICE_TOKEN=replace-with-a-random-token-of-at-least-24-characters
ANTHROPIC_API_KEY=
CLINIC_ANTHROPIC_MODEL=claude-sonnet-4-20250514
NOVA_AWS_REGION=us-east-1
NOVA_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Set AWS_PROFILE or use your normal AWS role/credential chain.
# AWS_PROFILE=venture-call-tests

# Optional real telephone calls. The app requires a separate explicit opt-in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS origin (or gateway prefix); Twilio must reach its signed webhooks.
TWILIO_PUBLIC_BASE_URL=
